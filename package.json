{
  "name": "distributed-wagering-processor",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:unit": "bun test --path-ignore-patterns='**/*.integration.spec.ts' src",
    "test:integration": "bun test --isolate integration.spec",
    "migration:create": "MIKRO_ORM_CLI_USE_TS_NODE=true mikro-orm migration:create",
    "migration:up": "MIKRO_ORM_CLI_USE_TS_NODE=true mikro-orm migration:up",
    "migration:down": "MIKRO_ORM_CLI_USE_TS_NODE=true mikro-orm migration:down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1167.0",
    "@mikro-orm/core": "6.6.17",
    "@mikro-orm/migrations": "6.6.17",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.17",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@mikro-orm/cli": "6.6.17",
    "@nestjs/testing": "^10.4.15",
    "@types/bun": "^1.1.14",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "dotenv": "^18.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
