# Aplicacao
PORT=3000
NODE_ENV=development

# Postgres (consumido pelo docker-compose.yml e pela aplicacao)
DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering_dev

# LocalStack / SQS (consumido pelo docker-compose.yml e pelo cliente SQS)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ADMIN_PORT=3999

# nginx - load balancer das 3 replicas da aplicacao (docker-compose.yml, servicos app-1/app-2/
# app-3) - porta publicada no host; porta interna do container continua 80
NGINX_PORT=80

# Paginacao do ledger (consumido por WalletLedgerEntryRepository - assina o cursor opaco)
LEDGER_CURSOR_SECRET=dev-only-ledger-cursor-secret-not-for-production

# Outbox Publisher Worker (ambos opcionais - defaults abaixo se omitidos)
OUTBOX_PUBLISHER_POLL_INTERVAL_MS=2000
OUTBOX_PUBLISHER_BATCH_SIZE=20

# DLQ Monitor (opcional - default abaixo se omitido)
DLQ_MONITOR_POLL_INTERVAL_MS=5000

# Observabilidade - Prometheus + Grafana + Loki/Promtail (extensao opcional, ver ARCHITECTURE.md
# secao 12.3). Grafana: http://localhost:3001 (login GRAFANA_ADMIN_USER/GRAFANA_ADMIN_PASSWORD) -
# datasources Prometheus/Loki e o dashboard "Distributed Wagering Processor - Overview" ja vem
# provisionados automaticamente, nada a configurar na UI.
PROMETHEUS_PORT=9090
LOKI_PORT=3100
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
